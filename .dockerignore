# Build context for the backend image (Dockerfile at the repo root).
# Root-level runtime data (level2_*.fits A/C/B frames, pipeline CSV/JSON
# outputs), data/time_compare_6month/ and backend/ must stay IN the context.

# VCS, editors, OS
.git
.kilo/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Frontend is a separate service
frontend/

# Python / environments
**/__pycache__/
**/*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# Secrets
.env
**/.env
**/.env.*
*.pem
*.key

# Logs
*.log
**/*.log

# Regenerable caches and large local-only data (spectral mosaic comes from a volume)
backend/preview_cache/
backend/cutout_cache/
data/spherex/
data/spherex_102/*.fits
data/spherex_102/*.fits.gz
data/injection_test/

# Not needed at runtime
docs/
data/pipeline_v1_backup/
